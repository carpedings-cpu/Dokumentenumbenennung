# Kopiere diese Datei nach ".env" und trage deine Werte ein.
# Die .env wird NICHT eingecheckt (siehe .gitignore).

# Stufe 2 (Claude-API) ein-/ausschalten. Standard: aus.
# Nur lokal NICHT eindeutige Mails gehen dann an die API.
TRIAGE_USE_API=false

# Claude-API-Schluessel (nur noetig, wenn TRIAGE_USE_API=true).
ANTHROPIC_API_KEY=
